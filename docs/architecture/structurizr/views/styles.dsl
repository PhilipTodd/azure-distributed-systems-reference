styles {
  element "Person" {
    shape person
  }

  element "External" {
    border dashed
  }

  element "System" {
    shape roundedBox
    background #106ebe
    color #ffffff
  }

  element "Web" {
    shape roundedBox
    background #277da8
    color #ffffff
  }

  element "Service" {
    shape roundedBox
    background #176b87
    color #ffffff
  }
}
