aquariumOwner -> parameterPilot.web "Uses" "HTTPS"
operator -> parameterPilot.web "Operates" "HTTPS"
parameterPilot.web -> parameterPilot.apiGateway "Calls" "HTTPS/JSON or bounded photo upload"
parameterPilot.web -> entra "Signs in with authorisation code + PKCE; obtains API access token" "OIDC/OAuth 2.0"
parameterPilot.apiGateway -> entra "Loads issuer metadata/signing keys for access-token validation" "HTTPS / OIDC metadata"
parameterPilot.apiGateway -> parameterPilot.aquariumService "Validates token and routes; Aquarium independently validates" "HTTPS/JSON"
parameterPilot.apiGateway -> parameterPilot.trackingService "Validates token and routes; Tracking independently validates" "HTTPS/JSON or bounded binary"
parameterPilot.apiGateway -> parameterPilot.advisorService "Validates token and routes; Advisor independently validates" "HTTPS/JSON"

parameterPilot.aquariumService -> parameterPilot.sqlDb "Synchronously reads/writes owned state; atomically writes outbox"
parameterPilot.trackingService -> parameterPilot.cosmosDb "Synchronously reads/writes owned history and same-partition outbox"
parameterPilot.trackingService -> parameterPilot.aquariumService "One batch per new panel: authorised tank access, current definition revisions, units and input-validation rules; fail closed" "HTTPS / OAuth OBO delegated token"
parameterPilot.trackingService -> parameterPilot.apiGateway "Returns saved data or photo job status" "HTTPS/JSON"
parameterPilot.trackingService -> parameterPilot.blobStorage "Saves private within-limit original after bounded validation" "HTTPS / managed identity"
parameterPilot.advisorService -> parameterPilot.aquariumService "Authorised profile/entitlement checks" "HTTPS / workload identity and verified actor"
parameterPilot.advisorService -> parameterPilot.advisorDb "Synchronously registers job/quota/outbox; reads result/history/input snapshots"
parameterPilot.advisorService -> parameterPilot.apiGateway "Returns 202 job Location or authorised history/result" "HTTPS/JSON"

parameterPilot.aquariumWorker -> parameterPilot.sqlDb "Reads local outbox; updates only Aquarium-owned task/inbox/projection state"
parameterPilot.aquariumWorker -> parameterPilot.serviceBus "Publishes Aquarium outbox; consumes assigned commands/subscriptions when justified"
parameterPilot.serviceBus -> parameterPilot.aquariumWorker "Delivers only Aquarium-addressed work/relevant subscriptions"
parameterPilot.trackingWorker -> parameterPilot.cosmosDb "Relays Tracking outbox; updates owned processing status/inbox/history"
parameterPilot.trackingWorker -> parameterPilot.blobStorage "Reads retained original; writes cropped thumbnail and padded hero WebP"
parameterPilot.trackingWorker -> parameterPilot.serviceBus "Publishes Tracking outbox; consumes assigned work"
parameterPilot.serviceBus -> parameterPilot.trackingWorker "Delivers Tracking photo commands and relevant event subscriptions"
parameterPilot.advisorWorker -> parameterPilot.advisorDb "Relays outbox; persists advice results/quotas/input snapshots; pgvector retrieval"
parameterPilot.advisorWorker -> parameterPilot.aquariumService "Gets authorised profile and entitlement" "HTTPS / workload identity and verified actor"
parameterPilot.advisorWorker -> parameterPilot.trackingService "Gets authorised measurement/maintenance/observation history" "HTTPS / workload identity and verified actor"
parameterPilot.advisorWorker -> parameterPilot.foundry "Requests text inference; no photo input" "HTTPS"
parameterPilot.advisorWorker -> parameterPilot.serviceBus "Publishes Advisor outbox; consumes advice commands/relevant events"
parameterPilot.serviceBus -> parameterPilot.advisorWorker "Delivers Advisor-addressed commands and relevant subscriptions"

parameterPilot.apiGateway -> stripe "Existing payment integration candidate; provider/adapter decision pending" "HTTPS"

parameterPilot.aquariumService -> parameterPilot.appInsights "Emits telemetry directly"
parameterPilot.trackingService -> parameterPilot.appInsights "Emits telemetry directly"
parameterPilot.advisorService -> parameterPilot.appInsights "Emits telemetry directly"
parameterPilot.aquariumWorker -> parameterPilot.appInsights "Emits telemetry with propagated trace context"
parameterPilot.trackingWorker -> parameterPilot.appInsights "Emits telemetry with propagated trace context"
parameterPilot.advisorWorker -> parameterPilot.appInsights "Emits telemetry with propagated trace context"
